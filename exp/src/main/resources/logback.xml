<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Disabled non useful logging from  BeanTools-->
    <logger name="com.simplikube.taf.core.util.BeanTools" level="OFF"/>
    <!-- Disabled non useful logging from  AllureLifecycle-->
    <logger name="io.qameta.allure.AllureLifecycle" level="OFF"/>

    <!-- Send debug messages to System.out -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <!-- By default, encoders are assigned the type ch.qos.logback.classic.encoder.PatternLayoutEncoder -->
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{5} - %thread - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- By default, the level of the root level is set to DEBUG -->
    <root level="TRACE">
        <appender-ref ref="STDOUT"/>
    </root>

</configuration>